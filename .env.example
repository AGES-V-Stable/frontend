# Optional backend origin. Empty means same-origin requests.
VITE_API_URL=
# Development proxy target for both /v1 and /api.
API_PROXY_TARGET=http://localhost:8080
# A seleção automática usa a única oferta válida ou a melhor entre as elegíveis.
# Ligar SOMENTE em sandbox após backend#100, revisão e validação E2E. Nunca como
# atalho para ativar movimentações reais antes de aprovação.
VITE_ENABLE_ORCHESTRATED_TRANSFERS=false
