# Optional backend origin. Empty means same-origin requests.
VITE_API_URL=
# Optional canonical frontend origin used to return to the same browser session after hosted terms.
VITE_APP_ORIGIN=
# Development proxy target for both /v1 and /api.
API_PROXY_TARGET=http://localhost:8080
# Habilita/desabilita o chatbot de suporte (padrão ligado quando omitida).
VITE_SUPPORT_CHAT_ENABLED=true
